# Host ports used by Compose
FRONTEND_PORT=5173
BACKEND_PORT=8080

# Backend runtime configuration
MONGO_URI=mongodb://database:27017/EcomSphere
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
EXTERNAL_API=https://dummyjson.com
CLIENT_URI=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# Optional integrations. Mock mode keeps the demo runnable without credentials.
USE_MOCK_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=walkthrough-placeholder
CLOUDINARY_API_KEY=walkthrough-placeholder
CLOUDINARY_API_SECRET=walkthrough-placeholder
USE_MOCK_STRIPE=true
STRIPE_API_KEY=sk_test_walkthrough_placeholder
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend build-time configuration. /api is handled by the Nginx reverse proxy.
VITE_API_BASE_URL=/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_walkthrough_placeholder
